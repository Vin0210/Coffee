# Supabase — create a free project at https://supabase.com, then:
# Project Settings → API → copy the Project URL and anon public key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public site URL — used for auth email redirects (confirmation, password reset).
# Production: your live domain, e.g. https://alegrexgoodhabits.com
# Dev: leave blank to use window.location.origin automatically.
VITE_SITE_URL=

# --- Transactional email (edge function secrets, NOT VITE_ — set via CLI) ---
# supabase secrets set RESEND_API_KEY=... EMAIL_FROM=... SHOP_EMAIL=...
# RESEND_API_KEY  resend.com → API Keys (free tier covers receipts)
# EMAIL_FROM      verified sender, e.g. "Alegre × Good Habits <hello@alegrexgoodhabits.com>"
# SHOP_EMAIL      new-order notifications, e.g. orders@alegrexgoodhabits.com
